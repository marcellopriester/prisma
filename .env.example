# Preencha na Vercel em Settings > Environment Variables.
# Nunca envie senhas, DATABASE_URL ou arquivos .env ao GitHub.
# Supabase Connect > Transaction pooler. Use a conexão real do projeto.
DATABASE_URL=
# Supabase Project URL e Publishable key (não service_role).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# UUID exato de Authentication > Users, para a conta administrativa confirmada.
ADMIN_USER_ID=
